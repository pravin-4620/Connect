# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# Server
FRONTEND_URL="https://your-frontend-domain.vercel.app"
PORT=5001
NODE_ENV="production"

# Gmail OAuth (Optional)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="https://your-backend-domain.com/api/auth/gmail-callback"

# OpenAI (Optional)
OPENAI_API_KEY=""

# AWS S3 (Optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
