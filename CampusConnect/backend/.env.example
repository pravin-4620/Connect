NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campusconnect
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/auth/gmail-callback
# Generate a 32-byte hex key; retain it to decrypt saved Gmail tokens.
GMAIL_TOKEN_KEY=
# Gmail filtering defaults. Allowed windows: newer_than:7d, newer_than:30d, newer_than:2m, newer_than:1y.
MAIL_SYNC_QUERY=newer_than:2m
MAIL_SYNC_MAX_MESSAGES=10000
# Optional for non-mail AI features such as resume analysis. Mail filtering uses the local model in backend/models.
OPENAI_API_KEY=
# Optional: create your first inbox account with npm run inbox:create-user.
INBOX_BOOTSTRAP_EMAIL=
INBOX_BOOTSTRAP_PASSWORD=
